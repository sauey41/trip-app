#!/bin/sh
case "$1" in
    start|stop|prestart|prestop|log)
        exit 0
        ;;
    status)
        if command -v curl >/dev/null 2>&1; then
            curl --silent --fail --max-time 3 http://127.0.0.1:18080/healthz >/dev/null 2>&1
            exit $?
        fi
        if command -v wget >/dev/null 2>&1; then
            wget -q -T 3 -O /dev/null http://127.0.0.1:18080/healthz >/dev/null 2>&1
            exit $?
        fi
        exit 1
        ;;
    *)
        exit 1
        ;;
esac
